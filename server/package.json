  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "onnxruntime-node@1.24.3": true,
    "better-sqlite3@12.11.1": true,
    "sharp@0.34.5": true,
    "protobufjs@7.6.5": true
  }
