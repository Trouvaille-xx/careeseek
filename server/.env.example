# ===== CareeSeek 后端环境变量 =====

# LLM 上游（托管版使用应用方 key）
UPSTREAM_BASE_URL=https://api.deepseek.com/v1
UPSTREAM_API_KEY=sk-你的deepseek密钥

# 支付模式：mock（演示/联调）| wechat（真实微信支付，需商户号）
PAY_MODE=mock

# 端口/主机
PORT=3001
HOST=0.0.0.0

# SQLite 数据库路径（默认 server/data/careeseek.db）
# DB_PATH=/app/data/careeseek.db

# 前端 dist 目录（Docker 内已内置；自定义部署时设置）
# DIST_DIR=/app/dist

# 请求上游超时（毫秒）
# PROXY_TIMEOUT_MS=95000

# CORS 白名单（逗号分隔；生产同域部署可留空）
# CORS_ORIGINS=http://localhost:5173,https://careeseek.example.com
