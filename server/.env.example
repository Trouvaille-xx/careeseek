# ===== CareeSeek 后端环境变量 =====

# LLM 上游（托管版使用应用方 key）
UPSTREAM_BASE_URL=https://api.deepseek.com/v1
UPSTREAM_API_KEY=sk-你的deepseek密钥

# 支付模式：mock（演示/联调）| wechat（真实微信支付，需商户号）
PAY_MODE=mock

# 端口/主机
PORT=3001
HOST=0.0.0.0

# SQLite 数据库路径（默认 server/data/careeseek.db）
# DB_PATH=/app/data/careeseek.db

# 前端 dist 目录（Docker 内已内置；自定义部署时设置）
# DIST_DIR=/app/dist

# 请求上游超时（毫秒）。默认 240000：默认输出上限 16384 token、重试 32768，
# 按实测约 200 token/秒，32768 需约 160 秒。须小于前端 API_TIMEOUT_MS（250000）。
# PROXY_TIMEOUT_MS=240000

# CORS 白名单（逗号分隔；生产同域部署可留空）
# CORS_ORIGINS=http://localhost:5173,https://careeseek.example.com

# 管理员邮箱（逗号分隔）：服务启动时把对应账号提升为 role=admin，注册后也会重新提升。
# 不设则没有任何账号是管理员（管理后台 /admin 与提示词维护入口都不会出现）。
# ADMIN_EMAILS=admin@example.com

# 提示词维护白名单（逗号分隔）：在 role=admin 基础上再收窄到指定邮箱。
# 留空则「管理员即可维护」。前端用 VITE_PROMPT_ADMIN_EMAILS 控制入口是否显示，后端以本变量为准。
# PROMPT_ADMIN_EMAILS=admin@example.com
